
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Book Journal</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<header class="header">
  <div class="container">
    <h1>My Book Journal</h1>
    <p>Every book has a story. Keep the lessons forever.</p>
  </div>
</header>

<main class="container">

  <section class="welcome">
    <h2>My Reading Collection</h2>
    <p>Discover, remember, and organize the books you have read.</p>
  </section>

  <!-- Search books from Open Library -->
  <section class="search-section">
    <h2>Find a Book</h2>

    <form action="/search" method="GET" class="search-form">
      <input
        type="text"
        name="q"
        placeholder="Search book title or author..."
        required
      >
      <button type="submit">Search</button>
    </form>
  </section>

  <!-- API search results -->
  <% if (searchResults.length > 0) { %>
    <section>
      <h2>Search Results</h2>

      <div class="book-grid">
        <% searchResults.forEach(book => { %>
          <div class="book-card">

            <% if (book.cover) { %>
              <img src="<%= book.cover %>" alt="Book cover">
            <% } else { %>
              <div class="no-cover">No Cover</div>
            <% } %>

            <h3><%= book.title %></h3>
            <p><%= book.author %></p>

            <form action="/books" method="POST">
              <input type="hidden" name="title" value="<%= book.title %>">
              <input type="hidden" name="author" value="<%= book.author %>">
              <input type="hidden" name="cover" value="<%= book.cover || '' %>">

              <label>Rating</label>
              <select name="rating">
                <option value="5">★★★★★</option>
                <option value="4">★★★★</option>
                <option value="3">★★★</option>
                <option value="2">★★</option>
                <option value="1">★</option>
              </select>

              <label>Reading Date</label>
              <input type="date" name="read_date">

              <label>My Notes</label>
              <textarea name="notes" placeholder="What did you learn from this book?"></textarea>

              <button type="submit">Add to My Collection</button>
            </form>

          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Sort books -->
  <section class="collection">
    <div class="section-heading">
      <h2>My Books</h2>

      <form action="/" method="GET">
        <select name="sort" onchange="this.form.submit()">
          <option value="newest" <%= sort === "newest" ? "selected" : "" %>>
            Newest First
          </option>
          <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>
            Oldest First
          </option>
          <option value="rating" <%= sort === "rating" ? "selected" : "" %>>
            Highest Rating
          </option>
          <option value="title" <%= sort === "title" ? "selected" : "" %>>
            Book Title
          </option>
        </select>
      </form>
    </div>

    <% if (books.length === 0) { %>
      <div class="empty">
        <h3>No books added yet.</h3>
        <p>Search for your first book above to start your collection.</p>
      </div>
    <% } %>

    <div class="book-grid">

      <% books.forEach(book => { %>
        <div class="book-card">

          <% if (book.cover) { %>
            <img src="<%= book.cover %>" alt="Book cover">
          <% } else { %>
            <div class="no-cover">No Cover</div>
          <% } %>

          <h3><%= book.title %></h3>
          <p class="author"><%= book.author %></p>

          <p class="rating">
            Rating:
            <%= "★".repeat(Number(book.rating)) %>
            <%= "☆".repeat(5 - Number(book.rating)) %>
          </p>

          <p class="date">
            Read:
            <%= book.read_date
              ? new Date(book.read_date).toLocaleDateString("en-GB", {timeZone: "UTC"})
              : "Not specified" %>
          </p>

          <div class="notes">
            <strong>My Notes:</strong>
            <p><%= book.notes || "No notes added." %></p>
          </div>

          <!-- Edit book -->
          <details class="edit-section">
            <summary>Edit Book</summary>

            <form action="/books/<%= book.id %>/update" method="POST">
              <label>Title</label>
              <input type="text" name="title" value="<%= book.title %>" required>

              <label>Author</label>
              <input type="text" name="author" value="<%= book.author %>" required>

              <label>Rating</label>
              <select name="rating">
                <% for (let i = 1; i <= 5; i++) { %>
                  <option value="<%= i %>" <%= Number(book.rating) === i ? "selected" : "" %>>
                    <%= i %> Stars
                  </option>
                <% } %>
              </select>

              <label>Reading Date</label>
              <input type="date" name="read_date"
                value="<%= book.read_date ? new Date(book.read_date).toISOString().slice(0, 10) : '' %>">

              <label>Notes</label>
              <textarea name="notes"><%= book.notes || "" %></textarea>

              <label>Cover Image URL</label>
              <input type="text" name="cover" value="<%= book.cover || '' %>">

              <button type="submit">Save Changes</button>
            </form>
          </details>

          <!-- Delete book -->
          <form action="/books/<%= book.id %>/delete" method="POST"
            onsubmit="return confirm('Are you sure you want to delete this book?')">
            <button type="submit" class="delete-button">Delete Book</button>
          </form>

        </div>
      <% }) %>

    </div>
  </section>

</main>

<footer>
  <p>My Book Journal | Read. Learn. Remember.</p>
</footer>

</body>
</html>
